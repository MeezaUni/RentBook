# Copy to `.env` (never commit `.env`). All values are optional; defaults shown.
# There are no secret keys here: logins use per-user PINs created from the command line,
# and sessions use random server-side tokens.

# development | production   (production turns on Secure cookies and hides API docs)
RENTBOOK_ENV=development

# Where the database, uploaded documents and backups are kept.
# RENTBOOK_DATA_DIR=./data

# Database URL. Default: SQLite file inside RENTBOOK_DATA_DIR.
# PostgreSQL example (needs the psycopg driver installed): postgresql+psycopg://user:CHANGE_ME@localhost/rentbook
# RENTBOOK_DATABASE_URL=sqlite:///./data/rentbook.db

# Set true when the site is served over HTTPS (default: true in production).
# RENTBOOK_COOKIE_SECURE=false

# How long a login lasts, in hours.
RENTBOOK_SESSION_HOURS=12

# Largest allowed upload (screenshots, receipts, statements), in MB.
RENTBOOK_MAX_UPLOAD_MB=15

# Login rate limit: failures allowed per IP address within the window.
RENTBOOK_LOGIN_MAX_FAILURES=5
RENTBOOK_LOGIN_WINDOW_MINUTES=15

RENTBOOK_LOG_LEVEL=INFO
